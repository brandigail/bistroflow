# Placeholder names only. Copy to .env.local (and Netlify env vars) and fill in real values. Never commit real keys.

# Neon Postgres. The pooled URL (host contains "-pooler") is used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# The direct (non-pooled) URL is used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Auth.js session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
